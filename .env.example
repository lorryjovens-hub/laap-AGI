# ============================================
# LAAP 环境变量配置
# ============================================
# 复制此文件并填入你的配置:
#   cp .env.example .env
#
# 共三档模式，按需配置:
#   [MIN]  = 仅填必填项，其余模块用 fallback
#   [STD]  = 标准体验，推荐
#   [FULL] = 全功能，所有模块启
# ============================================

# ── [MIN] 必填: LLM API 密钥 ─────────────────────────
# LAAP 的 PSI Core 依赖 LLM 进行需求调节和内容生成。
# 没有这个，认知循环会退化。
# 支持 DeepSeek / OpenAI / Anthropic 兼容 API。
DEEPSEEK_API_KEY=

# ── [STD] 可选: LLM 端点配置 ──────────────────────────
# 默认使用 DeepSeek，可切换为任意 OpenAI 兼容 API。
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# LLM_MODEL=deepseek-chat

# ── [STD] 可选: 飞书集成 ──────────────────────────────
# FEISHU_APP_ID=
# FEISHU_APP_SECRET=
# FEISHU_CHAT_ID=

# ── [STD] 可选: 端口配置 ──────────────────────────────
# 所有端口均有默认值，仅冲突时需修改。
LAAP_PORT=11546
LAAP_API_BASE=http://localhost:11546
# QUANTUM_PORT=11520
# PSI_ARIS_PORT=11551

# ── [FULL] 可选: 路径配置 ────────────────────────────
# Docker 部署下不需要修改——镜像内路径是固定的。
# 裸机部署时如果自动检测失败才需要显式指定。
# LAAP_ROOT=
# ARIS_BRAIN_ROOT=
# LAAP_STATE_DIR=
# HERMES_ROOT=

# ── [FULL] 可选: 记忆引擎 ────────────────────────────
# MEMORY_CAPACITY=10000

# ── [FULL] 可选: 日志 ────────────────────────────────
# LAAP_LOG_LEVEL=INFO
# 调试时改为 DEBUG
# LAAP_LOG_LEVEL=DEBUG

# ── [FULL] 可选: 小智 MCP ────────────────────────────
# XIAOZHI_MCP_TOKEN=

# ============================================
# 🔒 安全提醒
# ============================================
# .env 包含敏感 API 密钥，务必加入 .gitignore。
# 切勿提交到公开仓库！
# Docker 部署场景下，.env 不会被复制进镜像，
# 而是通过 docker compose 的 env_file 注入。
